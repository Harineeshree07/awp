clc; clear; close all;
fs = 10000; t = 0:1/fs:0.1-1/fs;     % sampling frequency, time vector (1000 samples)
signal    = sin(2*pi*1000*t);       % desired 1 kHz signal
emi_sine  = 0.5*sin(2*pi*2500*t);   % sinusoidal EMI (switching supply)
emi_noise = 0.3*randn(size(t));     % broadband EMI (sigma = 0.3)
emi_imp   = zeros(size(t)); emi_imp(1:20:end) = 1; % impulsive EMI (switching transients)
emi_total = emi_sine + emi_noise + emi_imp;
received  = signal + emi_total;
SNR_in = 10*log10(mean(signal.^2)/mean(emi_total.^2));  % input SNR (dB)

figure; subplot(3,1,1); plot(t,signal);   xlim([0 0.01]); title('Desired Signal');
subplot(3,1,2); plot(t,emi_total);        xlim([0 0.01]); title('Combined EMI');
subplot(3,1,3); plot(t,received);         xlim([0 0.01]); title('Received Signal with EMI');

N = length(received); f = (-N/2:N/2-1)*(fs/N);
Received_FFT = abs(fftshift(fft(received)))/N;
figure; plot(f,Received_FFT); xlim([0 5000]); grid on;
xlabel('Frequency (Hz)'); ylabel('Magnitude'); title('Frequency Spectrum');

[b,a] = butter(4,[700 1300]/(fs/2),'bandpass');  % EMI mitigation filter
cleaned = filtfilt(b,a,received);
SNR_out = 10*log10(mean(signal.^2)/mean((cleaned-signal).^2));
Improvement = SNR_out - SNR_in    % SNR improvement (dB)
